# Только для `pnpm dev` (в production env приходят из окружения контейнера).
# Куда Next проксирует /api в разработке (в production /api проксирует nginx)
API_PROXY_URL=http://localhost:8000
# Куда серверный код Next ходит за данными лендинга (в Docker — http://api:8000)
API_INTERNAL_URL=http://localhost:8000
# Публичный адрес сайта: canonical, Open Graph, robots.txt, sitemap.xml
SITE_URL=http://localhost:3000
# Куда Next проксирует /media в разработке: MinIO, бакет media (в production /media проксирует nginx)
MEDIA_PROXY_URL=http://localhost:9000/media
# только dev; должен совпадать с REVALIDATE_SECRET в .env
REVALIDATE_SECRET=dev-revalidate-secret-change-me
