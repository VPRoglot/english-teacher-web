# Скопируйте в .env и поменяйте пароли. .env не коммитится.
# Значения ниже рассчитаны на запуск через Docker Compose (хосты postgres/redis — имена сервисов).
# Для backend вне Docker (`just api`, alembic/cli из backend/) этот файл не меняйте — создайте
# backend/.env, он переопределяет значения отсюда:
#   DATABASE_URL=postgresql+asyncpg://tutor:change-me@localhost:5432/tutor
#   REDIS_URL=redis://localhost:6379/0
# Тестам .env не нужен — они поднимают свои контейнеры.

# Окружение: dev | test | prod (в prod отключён Swagger /api/docs)
APP_ENV=dev
# Уровень логов: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# true — JSON-логи (prod), false — читаемые цветные логи (dev)
LOG_JSON=false

# Учётные данные PostgreSQL (используются контейнером postgres при первом запуске)
POSTGRES_USER=tutor
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tutor

# Строка подключения backend к PostgreSQL (драйвер asyncpg обязателен)
DATABASE_URL=postgresql+asyncpg://tutor:change-me@postgres:5432/tutor
# Подключение к Redis (сессии, rate limit, очередь задач)
REDIS_URL=redis://redis:6379/0
