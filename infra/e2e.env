# Окружение e2e-стека (`just e2e`, CI job `e2e`): production-подобный стек на https://tutor.test.
# Только тестовые значения для tutor.test — не секреты, файл коммитится. Используется дважды:
#   --env-file infra/e2e.env  — подстановка ${…} в compose-файлах;
#   env_file: !override [e2e.env] — окружение postgres/api/worker/scheduler/migrate
#     (корневой .env разработчика в e2e не попадает).

# Образы собираются локально (docker-compose.e2e.yml), реестр не нужен.
IMAGE_REGISTRY=local
IMAGE_TAG=e2e

# nginx: домен, на который выпущен self-signed сертификат (/media/ → MinIO задаёт prod-оверлей).
DOMAIN=tutor.test

# test, а не prod: prod-валидаторы требуют ключи SmartCaptcha и Telegram.
APP_ENV=test
LOG_LEVEL=INFO
LOG_JSON=true

POSTGRES_USER=tutor
POSTGRES_PASSWORD=e2e-postgres-password
POSTGRES_DB=tutor
DATABASE_URL=postgresql+asyncpg://tutor:e2e-postgres-password@postgres:5432/tutor
REDIS_URL=redis://redis:6379/0

SESSION_COOKIE_SECURE=true
PUBLIC_BASE_URL=https://tutor.test
SITE_URL=https://tutor.test
REVALIDATE_SECRET=e2e-revalidate-secret-0123456789

# MinIO из prod-оверлея: root-учётка — только для minio и minio-init, приложение работает под
# своим пользователем (S3_ACCESS_KEY). Адрес MinIO для api задаёт prod-оверлей.
MINIO_ROOT_USER=minio-e2e-root
MINIO_ROOT_PASSWORD=minio-e2e-root-secret
S3_BUCKET=media
S3_ACCESS_KEY=minio-e2e
S3_SECRET_KEY=minio-e2e-secret
S3_REGION=us-east-1
MEDIA_PUBLIC_BASE_URL=/media

# Без капчи и Telegram: форма заявки работает без проверки, уведомления отключены.
SMARTCAPTCHA_CLIENT_KEY=

# Репетитор e2e: создаётся `e2e/create-tutor.sh` внутри api, входит в global-setup Playwright.
# Email на example.com: адрес на .test backend отклоняет (special-use домен в email-validator).
E2E_TUTOR_EMAIL=tutor@example.com
E2E_TUTOR_PASSWORD=e2e-tutor-pass-2026

# certbot в e2e отключён (profiles: ["never"]), но compose подставляет его обязательные
# переменные при разборе файла — нужна заглушка. Переменные бэкапа необязательны.
LETSENCRYPT_EMAIL=e2e@tutor.test
