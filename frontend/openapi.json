  "info": {
    "title": "English Tutor API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/admin/children/{child_id}": {
      "patch": {
        "operationId": "update_child",
        "parameters": [
          {
            "in": "path",
            "name": "child_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Child Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChildUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChildDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Ошибка в едином формате"
          }
        },
        "summary": "Update Child",
        "tags": [
          "admin"
        ]
      }
    },
    "/api/admin/children/{child_id}/account": {
      "post": {
        "operationId": "set_child_account_admin",
        "parameters": [
          {
            "in": "path",
            "name": "child_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Child Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
