              "schema": {
                "$ref": "#/components/schemas/ChildAccountSet"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChildDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "4XX": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Ошибка в едином формате"
          }
        },
        "summary": "Set Child Account Admin",
        "tags": [
          "admin"
        ]
      }
    },
