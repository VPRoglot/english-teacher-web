# Шаблон /etc/nginx/conf.d/default.conf (контекст http).
# envsubst подставляет только ${SERVER_NAME}, ${MEDIA_UPSTREAM}, ${MEDIA_UPSTREAM_HOST}
# (NGINX_ENVSUBST_FILTER в Dockerfile); остальные $-переменные — nginx'а.

server_tokens off;
client_max_body_size 6m;

# Встроенный DNS Docker. Upstream'ы задаются переменными, поэтому имя резолвится на запросе,
# а не один раз при старте: после пересоздания контейнера api новый IP подхватывается за ≤ 10 с.
resolver 127.0.0.11 valid=10s ipv6=off;
resolver_timeout 5s;

gzip on;
gzip_vary on;
gzip_proxied any;
gzip_min_length 1024;
gzip_types text/plain text/css text/javascript application/javascript application/json
    application/manifest+json image/svg+xml;

# Входящий X-Request-ID принимается в том же формате, что и в backend (app.core.request_id),
# иначе — собственный $request_id nginx (32 hex).
map $http_x_request_id $req_id {
    "~^[A-Za-z0-9._-]{1,64}$" $http_x_request_id;
    default $request_id;
}

# error_log не маскируется: на ошибках upstream nginx пишет туда строку запроса и referer
# с токенами. Поэтому только crit; статус, upstream_* и request_time есть в access-логе.
error_log /var/log/nginx/error.log crit;

# Одноразовые токены маскируются в access-логе — префиксы те же, что у scrub_text в backend
# (app.core.observability), плюс URL-кодированный «/» (%2F) для query. Правила по порядку:
# 1) два и больше префиксов: всё после первого заменяется на *** — ни один токен не утекает;
# 2) один префикс: маскируется сегмент токена, хвост сохраняется (/api/auth/invitations/***/accept);
# 3) префикс с необычным токеном (например, начинается с %): всё после префикса — ***.
map $request_uri $log_uri {
    "~^(?<tok_multi>.*?(?:/|%2[Ff])(?:invite|reset|api(?:/|%2[Ff])auth(?:/|%2[Ff])invitations|api(?:/|%2[Ff])auth(?:/|%2[Ff])password-resets)(?:/|%2[Ff])).*(?:/|%2[Ff])(?:invite|reset|api(?:/|%2[Ff])auth(?:/|%2[Ff])invitations|api(?:/|%2[Ff])auth(?:/|%2[Ff])password-resets)(?:/|%2[Ff])" "${tok_multi}***";
    "~^(?<tok_pre>.*?(?:/|%2[Ff])(?:invite|reset|api(?:/|%2[Ff])auth(?:/|%2[Ff])invitations|api(?:/|%2[Ff])auth(?:/|%2[Ff])password-resets)(?:/|%2[Ff]))[^/?#&%\s\"']+(?<tok_post>.*)$" "${tok_pre}***${tok_post}";
    "~^(?<tok_any>.*?(?:/|%2[Ff])(?:invite|reset|api(?:/|%2[Ff])auth(?:/|%2[Ff])invitations|api(?:/|%2[Ff])auth(?:/|%2[Ff])password-resets)(?:/|%2[Ff]))" "${tok_any}***";
    default $request_uri;
}
# Referer страницы /invite/<token> несёт тот же токен (same-origin запросы ассетов).
map $http_referer $log_referer {
    "~^(?<ref_multi>.*?(?:/|%2[Ff])(?:invite|reset|api(?:/|%2[Ff])auth(?:/|%2[Ff])invitations|api(?:/|%2[Ff])auth(?:/|%2[Ff])password-resets)(?:/|%2[Ff])).*(?:/|%2[Ff])(?:invite|reset|api(?:/|%2[Ff])auth(?:/|%2[Ff])invitations|api(?:/|%2[Ff])auth(?:/|%2[Ff])password-resets)(?:/|%2[Ff])" "${ref_multi}***";
    "~^(?<ref_pre>.*?(?:/|%2[Ff])(?:invite|reset|api(?:/|%2[Ff])auth(?:/|%2[Ff])invitations|api(?:/|%2[Ff])auth(?:/|%2[Ff])password-resets)(?:/|%2[Ff]))[^/?#&%\s\"']+(?<ref_post>.*)$" "${ref_pre}***${ref_post}";
    "~^(?<ref_any>.*?(?:/|%2[Ff])(?:invite|reset|api(?:/|%2[Ff])auth(?:/|%2[Ff])invitations|api(?:/|%2[Ff])auth(?:/|%2[Ff])password-resets)(?:/|%2[Ff]))" "${ref_any}***";
    default $http_referer;
}

# MEDIA_UPSTREAM = https://storage.yandexcloud.net/<bucket> → origin + префикс пути.
map "${MEDIA_UPSTREAM}" $media_origin {
    "~^(?<media_o>https?://[^/]+)" $media_o;
}
map "${MEDIA_UPSTREAM}" $media_prefix {
    "~^https?://[^/]+(?<media_p>(?:/[^/]+)*)/*$" $media_p;
    default "";
}

log_format json escape=json
    '{"time":"$time_iso8601",'
    '"request_id":"$req_id",'
    '"remote_addr":"$remote_addr",'
    '"host":"$host",'
    '"method":"$request_method",'
    '"uri":"$log_uri",'
    '"protocol":"$server_protocol",'
    '"status":$status,'
    '"bytes_sent":$body_bytes_sent,'
    '"request_time":$request_time,'
    '"upstream_addr":"$upstream_addr",'
    '"upstream_status":"$upstream_status",'
    '"upstream_response_time":"$upstream_response_time",'
    '"referer":"$log_referer",'
    '"user_agent":"$http_user_agent"}';

server {
    listen 80 default_server;
    server_name ${SERVER_NAME};
    access_log /var/log/nginx/access.log json;

    # Healthcheck образа (HEALTHCHECK в Dockerfile) — до редиректа на https.
    location = /nginx-health {
        access_log off;
        return 200;
    }

    # Webroot для certbot (HTTP-01).
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
    }

    location / {
        return 301 https://${SERVER_NAME}$request_uri;
    }
}

server {
    listen 443 ssl default_server;
    http2 on;
    server_name ${SERVER_NAME};
    access_log /var/log/nginx/access.log json;

    # Symlink выбирает 40-select-cert.sh: Let's Encrypt или self-signed.
    ssl_certificate /etc/nginx/tls/current/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/current/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Заголовки безопасности — только здесь: add_header в location отменил бы наследование.
    # HSTS без includeSubDomains: на домене могут быть чужие поддомены.
    add_header Strict-Transport-Security "max-age=31536000" always;
    # CSP без nonce (Review Focus, уточнение 4): nonce сделал бы лендинг динамическим.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://smartcaptcha.yandexcloud.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://smartcaptcha.yandexcloud.net; font-src 'self' data:; connect-src 'self' https://smartcaptcha.yandexcloud.net; frame-src https://smartcaptcha.yandexcloud.net; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header X-Request-ID $req_id always;

    set $api http://api:8000;
    set $web http://web:3000;

    proxy_http_version 1.1;
    # В сети compose соединение устанавливается мгновенно; ушедший IP не должен держать запрос минуту.
    proxy_connect_timeout 5s;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    # Перезаписывается, а не дополняется: backend доверяет самому левому адресу XFF.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Request-ID $req_id;
    # Свой X-Request-ID nginx добавляет сам; upstream'овый дал бы дубль.
    proxy_hide_header X-Request-ID;
    proxy_hide_header X-Powered-By;

    location /api/ {
        proxy_pass $api;
    }

    # Публичный S3-бакет: /media/<key> → ${MEDIA_UPSTREAM}/<key>.
    location /media/ {
        if ($request_method !~ ^(GET|HEAD)$) {
            return 405;
        }
        # proxy_pass с переменной не заменяет префикс location — путь переписывается явно.
        # Именованная группа: regex из map $media_prefix затирает нумерованные $1.
        rewrite "^/media/(?<media_key>.*)$" $media_prefix/$media_key? break;
        proxy_pass $media_origin;

        # proxy_set_header здесь отменяет серверные — клиентские X-Forwarded-*, cookie
        # и Authorization хранилищу не нужны.
        proxy_set_header Host ${MEDIA_UPSTREAM_HOST};
        proxy_set_header Cookie "";
        proxy_set_header Authorization "";
        proxy_set_header Connection "";
        # Для https-хранилища сертификат проверяется (для http-апстрима, как minio в e2e, не действует).
        proxy_ssl_server_name on;
        proxy_ssl_name ${MEDIA_UPSTREAM_HOST};
        proxy_ssl_verify on;
        proxy_ssl_verify_depth 3;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_hide_header Set-Cookie;
        proxy_hide_header X-Request-ID;
        proxy_hide_header X-Powered-By;
        proxy_hide_header x-amz-request-id;
        proxy_hide_header x-amz-id-2;
        expires 7d;
    }

    location /_next/static/ {
        proxy_pass $web;
        expires 1y;
    }

    location / {
        proxy_pass $web;
    }
}
