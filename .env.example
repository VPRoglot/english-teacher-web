# Скопируйте в .env и поменяйте пароли. .env не коммитится.
# Значения ниже рассчитаны на запуск через Docker Compose (хосты postgres/redis — имена сервисов).
# Для backend вне Docker (`just api`, alembic/cli из backend/) этот файл не меняйте — создайте
# backend/.env, он переопределяет значения отсюда:
#   DATABASE_URL=postgresql+asyncpg://tutor:change-me@localhost:5432/tutor
#   REDIS_URL=redis://localhost:6379/0
#   S3_ENDPOINT_URL=http://localhost:9000
# Тестам .env не нужен — они поднимают свои контейнеры.

# Окружение: dev | test | prod (в prod отключён Swagger /api/docs)
APP_ENV=dev
# Уровень логов: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# true — JSON-логи (prod), false — читаемые цветные логи (dev)
LOG_JSON=false

# Учётные данные PostgreSQL (используются контейнером postgres при первом запуске)
POSTGRES_USER=tutor
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tutor

# Строка подключения backend к PostgreSQL (драйвер asyncpg обязателен)
DATABASE_URL=postgresql+asyncpg://tutor:change-me@postgres:5432/tutor
# Подключение к Redis (сессии, rate limit, очередь задач)
REDIS_URL=redis://redis:6379/0

# Cookie сессии только по HTTPS. false — только для локальной разработки по http://localhost
SESSION_COOKIE_SECURE=true
# Публичный адрес сайта (без завершающего /): из него строятся ссылки в письмах и приглашениях
PUBLIC_BASE_URL=http://localhost:3000
# Публичный адрес сайта для frontend (без завершающего /): canonical, Open Graph, robots.txt и
# sitemap.xml. Читается во время запроса, при сборке не нужна.
SITE_URL=http://localhost:3000

# Доверенные адреса прокси для X-Forwarded-For/Proto (через запятую или *). Задавать только
# за nginx, который перезаписывает XFF; иначе клиент подделает IP и обойдёт rate limit.
# В dev оставить пустым: заголовки игнорируются.
FORWARDED_ALLOW_IPS=

# Общий секрет backend ↔ frontend: worker сбрасывает кеш лендинга запросом
# POST /api/revalidate с заголовком Authorization: Bearer <секрет>. Не короче 16 символов,
# в prod — случайная строка (например, `openssl rand -hex 32`).
REVALIDATE_SECRET=dev-revalidate-secret-change-me
# Куда worker отправляет сброс кеша. Docker Compose задаёт значение сам (http://web:3000/api/revalidate,
# в dev — http://host.docker.internal:3000/api/revalidate, потому что Next запущен на хосте),
# поэтому строка закомментирована. Для worker вне Docker (`just worker`) по умолчанию
# http://localhost:3000/api/revalidate.
# REVALIDATE_URL=http://localhost:3000/api/revalidate

# Хранилище медиа (фото на лендинге). В разработке — MinIO из docker compose.
# Переменная S3_ENDPOINT_URL не задана (строку удалить) — настоящий AWS S3. Для backend вне Docker (`just api`) в backend/.env
# нужна строка S3_ENDPOINT_URL=http://localhost:9000
S3_ENDPOINT_URL=http://minio:9000
# Регион S3 (для MinIO значения не имеет; для AWS S3 — регион бакета)
# S3_REGION=us-east-1
S3_BUCKET=media
S3_ACCESS_KEY=minio-dev
S3_SECRET_KEY=minio-dev-secret
# path (MinIO) | virtual (AWS S3)
S3_ADDRESSING_STYLE=path
# Префикс публичных URL фото: {префикс}/{ключ в S3}. По умолчанию /media (проксируется на хранилище)
MEDIA_PUBLIC_BASE_URL=/media

# Yandex SmartCaptcha. Ключи берутся в консоли Yandex Cloud → SmartCaptcha → ваша капча:
# «Ключ сервера» (SMARTCAPTCHA_SERVER_KEY, читает backend) и «Ключ клиента»
# (SMARTCAPTCHA_CLIENT_KEY, читает frontend во время запроса).
# Без ключей капча отключена (dev); серверный ключ в prod обязателен.
# Ключи задаются ПАРОЙ: серверный без клиентского — каждая заявка получает 400 captcha_failed.
# Клиентский ключ: Compose передаёт его только контейнеру web (`just dev-full`, prod). При обычном
# `just web` Next работает на хосте и читает frontend/.env.development, а не этот файл — впишите
# SMARTCAPTCHA_CLIENT_KEY туда.
# После правки .env пересоздайте контейнеры (`just dev`): `just restart` новые значения не подхватит.
# SMARTCAPTCHA_SERVER_KEY=
# SMARTCAPTCHA_CLIENT_KEY=
# Telegram-бот для уведомлений о новых заявках: токен выдаёт @BotFather. В prod обязательны
# все три значения: SMARTCAPTCHA_SERVER_KEY, TELEGRAM_BOT_TOKEN и TELEGRAM_CHAT_ID. Чтобы узнать
# chat_id, напишите боту любое сообщение и откройте
# https://api.telegram.org/bot<токен>/getUpdates — id в поле message.chat.id (для группы, если там
# только my_chat_member, — my_chat_member.chat.id).
# Без значений уведомления отключены (dev): worker пишет в лог telegram_disabled.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Сколько секунд API ждёт постановки задачи в очередь (по умолчанию 2). Если Redis завис,
# ответ не блокируется дольше: заявка сохраняется, в лог пишется lead_notification_enqueue_failed.
# TASK_ENQUEUE_TIMEOUT_SECONDS=2

# Мониторинг (необязателен). Sentry: DSN проекта из sentry.io; без него отправка отключена.
# SENTRY_DSN=
# Доля транзакций для трассировки, 0..1 (по умолчанию 0 — только ошибки)
# SENTRY_TRACES_SAMPLE_RATE=0
# DSN проекта Sentry/GlitchTip для frontend (контейнер web получает его как SENTRY_DSN, релиз —
# IMAGE_TAG). Браузерные события идут через туннель /monitoring; DSN браузера встраивается при
# сборке образа (build arg NEXT_PUBLIC_SENTRY_DSN, в CD — vars.SENTRY_DSN_WEB) — обычно тот же.
# SENTRY_DSN_WEB=
# Heartbeat-пинги (healthchecks.io или аналог): задача шлёт GET на URL после успешного запуска,
# монитор поднимает тревогу, если пинга нет дольше срока. Адреса содержат секрет — не коммитить.
# Ежедневная материализация серий занятий (worker)
# HEARTBEAT_MATERIALIZE_URL=
# Ежедневное удаление устаревших заявок (worker)
# HEARTBEAT_ANONYMIZE_URL=
# Ежедневный бэкап БД (скрипт бэкапа на хосте)
# HEARTBEAT_BACKUP_URL=
