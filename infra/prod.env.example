# Production-окружение. На сервере скопируйте в корень репозитория как .env (chmod 600)
# и замените все change-me: backend в prod не стартует, пока заглушки на месте.
# .env не коммитится. Один файл читают и docker compose (--env-file .env, подстановка ${…}
# в docker-compose.prod.yml), и backend-контейнеры (env_file: ../.env). Контейнер web получает
# только SITE_URL, REVALIDATE_SECRET и SMARTCAPTCHA_CLIENT_KEY; backup — только свои переменные.

# --- Домен и образы --------------------------------------------------------------------------
# Домен сайта (без схемы): server_name nginx, сертификат Let's Encrypt, smoke-проверка деплоя
DOMAIN=change-me.example.com
# Почта для уведомлений Let's Encrypt (истечение сертификата)
LETSENCRYPT_EMAIL=change-me@example.com
# Реестр образов: ghcr.io/<владелец репозитория в нижнем регистре>
IMAGE_REGISTRY=ghcr.io/change-me
# Текущий релиз: sha-<полный sha коммита, 40 hex>. Меняет только infra/scripts/deploy.sh;
# по нему же deploy.sh находит коммит для отката. Перед первым деплоем — sha текущего коммита.
# Backend отправляет его в Sentry как release.
IMAGE_TAG=sha-0000000000000000000000000000000000000000

# --- Приложение ------------------------------------------------------------------------------
# Окружение: в prod отключён Swagger и включены проверки настроек
APP_ENV=prod
# Уровень логов: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# JSON-логи (docker compose prod всё равно задаёт true для backend)
LOG_JSON=true
# Cookie сессии только по HTTPS — в prod обязательно true
SESSION_COOKIE_SECURE=true
# Публичный адрес сайта (https, без завершающего /): ссылки в письмах и приглашениях
PUBLIC_BASE_URL=https://change-me.example.com
# Тот же адрес для frontend: canonical, Open Graph, robots.txt, sitemap.xml
SITE_URL=https://change-me.example.com
# Доверенные прокси для X-Forwarded-*. В prod docker-compose.prod.yml задаёт "*" для api сам:
# порт api не опубликован, а nginx перезаписывает X-Forwarded-For. Строку не раскомментируйте.
# FORWARDED_ALLOW_IPS=
# Общий секрет backend ↔ frontend для сброса кеша лендинга: openssl rand -hex 32
REVALIDATE_SECRET=change-me-openssl-rand-hex-32

# --- PostgreSQL ------------------------------------------------------------------------------
# Учётные данные (контейнер postgres создаёт их при первом запуске; backup берёт отсюда же).
# Пароль: openssl rand -hex 24 (только [0-9a-f] — не нужно экранировать в DATABASE_URL)
POSTGRES_USER=tutor
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tutor
# Строка подключения backend: тот же пароль, драйвер asyncpg, хост — сервис postgres
DATABASE_URL=postgresql+asyncpg://tutor:change-me@postgres:5432/tutor

# --- Redis -----------------------------------------------------------------------------------
# Сессии, rate limit, очередь задач (AOF включён в docker-compose.prod.yml)
REDIS_URL=redis://redis:6379/0

# --- Хранилище медиа (S3) --------------------------------------------------------------------
# Публичный бакет с фото лендинга, например Yandex Object Storage
S3_ENDPOINT_URL=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=change-me-media
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
# path | virtual (для Yandex Object Storage и AWS — virtual или path, оба работают)
S3_ADDRESSING_STYLE=path
# Префикс публичных URL фото; /media проксирует nginx на MEDIA_UPSTREAM
MEDIA_PUBLIC_BASE_URL=/media
# Куда nginx проксирует /media/<ключ>: адрес бакета (https://<хост>/<бакет>) и его хост
MEDIA_UPSTREAM=https://storage.yandexcloud.net/change-me-media
MEDIA_UPSTREAM_HOST=storage.yandexcloud.net

# --- Yandex SmartCaptcha (в prod обязательна) ------------------------------------------------
# Консоль Yandex Cloud → SmartCaptcha → ваша капча. Ключи задаются парой.
SMARTCAPTCHA_SERVER_KEY=change-me
SMARTCAPTCHA_CLIENT_KEY=change-me

# --- Telegram (в prod обязателен) ------------------------------------------------------------
# Токен бота от @BotFather и chat_id получателя уведомлений о заявках
TELEGRAM_BOT_TOKEN=change-me
TELEGRAM_CHAT_ID=change-me
# Сколько секунд API ждёт постановки задачи в очередь
TASK_ENQUEUE_TIMEOUT_SECONDS=2

# --- Мониторинг (необязателен) ---------------------------------------------------------------
# DSN проекта Sentry/GlitchTip. Не задан (строка закомментирована) — отправка отключена.
# SENTRY_DSN=
# Доля трассируемых транзакций, 0..1
SENTRY_TRACES_SAMPLE_RATE=0
# DSN проекта Sentry для frontend: серверная часть web (контейнер получает его как SENTRY_DSN).
# Браузерный DSN встраивается в образ при сборке (vars.SENTRY_DSN_WEB в GitHub Actions) и
# работает только с DSN sentry.io (туннель /monitoring). Не задан — серверный Sentry web отключён.
# SENTRY_DSN_WEB=
# Heartbeat-пинги (healthchecks.io и т. п.) после успешного запуска ежедневных задач.
# Адреса содержат секрет. Не задан (строка закомментирована) — пинг отключён; не оставляйте
# пустое значение «KEY=».
# Материализация серий занятий (worker)
# HEARTBEAT_MATERIALIZE_URL=
# Обезличивание устаревших заявок (worker)
# HEARTBEAT_ANONYMIZE_URL=
# Ежедневный бэкап БД (контейнер backup)
# HEARTBEAT_BACKUP_URL=

# --- Бэкапы (контейнер backup) ---------------------------------------------------------------
# Отдельный ПРИВАТНЫЙ бакет: обязан отличаться от S3_BUCKET, иначе бэкап завершится ошибкой
BACKUP_S3_BUCKET=change-me-backups
# Endpoint S3-совместимого хранилища; пусто — AWS S3
BACKUP_S3_ENDPOINT_URL=https://storage.yandexcloud.net
BACKUP_S3_REGION=ru-central1
# Отдельный ключ с доступом только к бакету бэкапов
BACKUP_S3_ACCESS_KEY=change-me
BACKUP_S3_SECRET_KEY=change-me
# Публичный ключ age (age-keygen → строка «public key: age1…»). Приватный ключ хранится
# у владельца вне сервера и нужен только для восстановления.
BACKUP_AGE_RECIPIENT=change-me
